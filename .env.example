# === CONFIGURACIÓN DE LA API WRAPPER (Express) ===
PORT=3000

# === SUPABASE CREDENTIALS ===
# Crea un nuevo proyecto en Supabase, ve a Project Settings -> API y copia estos valores:
SUPABASE_URL=https://tu-proyecto.supabase.co
# IMPORTANTE: Usa la "service_role key" (secreta) para poder saltar el RLS desde el backend
SUPABASE_SERVICE_KEY=ey...

# === CONFIGURACIÓN DE EVOLUTION API ===
# Esta URL debe apuntar al contenedor local de Evolution API o su IP pública
EVOLUTION_API_URL=http://localhost:8080
# Esta key es la contraseña global que pones en el docker-compose.yml de Evolution API
EVOLUTION_GLOBAL_API_KEY=super_secret_key_123
# Nombre de la instancia de WhatsApp que vas a conectar escaneando el QR (ej. "mi_numero")
EVOLUTION_INSTANCE_NAME=mi_numero
